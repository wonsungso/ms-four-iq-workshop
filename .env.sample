# Azure AI Search Configuration (Entra ID auth only - no API keys)
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net

# Azure OpenAI Configuration (Entra ID auth only - no API keys)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_CHATGPT_MODEL_NAME=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_TENANT_ID=your-tenant-id

# Work IQ (Parts 4, 6): customer API app, login client and Search federated credential
# After registration: python infra/configure-work-iq.py fills these four values.
WORK_IQ_TENANT_ID=your-m365-tenant-id
WORK_IQ_APPLICATION_ID=your-customer-api-app-client-id
WORK_IQ_CLIENT_ID=your-login-client-app-client-id
WORK_IQ_FEDERATED_CREDENTIAL_ID=your-federated-credential-object-id

# Fabric IQ (Parts 3, 5, 6)
FABRIC_WORKSPACE_ID=your-fabric-workspace-id
FABRIC_ONTOLOGY_ID=your-fabric-ontology-id

# Web IQ (live web search)
WEB_IQ_KEY=your-web-iq-key
